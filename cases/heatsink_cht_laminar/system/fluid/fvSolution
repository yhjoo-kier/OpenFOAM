FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      fvSolution;
}

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    p
    {
        $p_rgh;
    }

    "(U|k|epsilon|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|k|epsilon|omega)Final"
    {
        $U;
        relTol          0;
    }

    "(h|e)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(h|e)Final"
    {
        $h;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 1;
    nCorrectors         2;
    nOuterCorrectors    1;
    pRefCell            0;
    pRefValue           0;
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;
    pMinFactor      0.5;
    pMaxFactor      1.5;
    rhoMin          0.5;
    rhoMax          2.0;

    residualControl
    {
        p               1e-4;
        U               1e-4;
        "(h|e)"         1e-4;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
        p_rgh           0.3;
        rho             0.1;
    }
    equations
    {
        U               0.5;
        "(h|e)"         0.3;
    }
}
