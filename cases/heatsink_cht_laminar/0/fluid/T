boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 293.15;
    }
    outlet
    {
        type            zeroGradient;
    }
    fluid_top
    {
        type            zeroGradient;
    }
    walls_fluid
    {
        type            zeroGradient;
    }
    tube_walls
    {
        type            zeroGradient;
    }
    fluid_to_solid
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     fluidThermo;
        value           uniform 293.15;
    }
}
