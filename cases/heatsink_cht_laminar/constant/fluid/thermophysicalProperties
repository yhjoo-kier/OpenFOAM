FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/fluid";
    object      thermophysicalProperties;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   18.015;  // Water
    }
    thermodynamics
    {
        Cp          4182;    // J/kg/K
        Hf          0;
    }
    transport
    {
        mu          0.001;   // Pa.s (water at 20°C)
        Pr          7.0;
        kappa       0.6;     // W/m/K
    }
    equationOfState
    {
        rho         998;     // kg/m³
    }
}
