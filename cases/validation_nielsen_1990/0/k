    {
        type            fixedValue;
        value           uniform 0.000776;
    }
    outlet
    {
        type            zeroGradient;
    }
    topWall
    {
        type            kqRWallFunction;
        value           uniform 0.000776;
    }
    bottomWall
    {
        type            kqRWallFunction;
        value           uniform 0.000776;
    }
    leftWall
    {
        type            kqRWallFunction;
        value           uniform 0.000776;
    }
    rightWall
    {
        type            kqRWallFunction;
        value           uniform 0.000776;
    }
    frontAndBack
    {
        type            empty;
    }
}
