FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1e-08;
boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-08;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1e-08;
        value           uniform 1e-08;
    }

    roomWalls
    {
        type            kqRWallFunction;
        value           uniform 1e-08;
    }

    obstacleWalls
    {
        type            kqRWallFunction;
        value           uniform 1e-08;
    }

    defaultFaces
    {
        type            calculated;
        value           uniform 1e-08;
    }
}
